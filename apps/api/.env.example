# Local development defaults — matches docker-compose. Railway injects PORT and
# DATABASE_URL itself when a Postgres service is attached.
PORT=3000
DATABASE_URL=postgresql://arcadia:arcadia@localhost:55432/arcadia
# Comma-separated browser origins allowed to send credentials (cookies)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Seeded accounts. Dev defaults are admin1234 / demo1234; in production the
# accounts are ONLY created when these are set explicitly.
# ADMIN_PASSWORD=
# DEMO_PASSWORD=

# FatSecret Platform (https://platform.fatsecret.com — free Basic tier).
# When set, FatSecret is the primary food-search source (USDA becomes backup).
# Remember to allow your server egress IPs in the FatSecret console.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
