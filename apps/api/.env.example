# Local development defaults — matches docker-compose. Railway injects PORT and
# DATABASE_URL itself when a Postgres service is attached.
PORT=3000
DATABASE_URL=postgresql://arcadia:arcadia@localhost:55432/arcadia
# Comma-separated browser origins allowed to send credentials (cookies)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Seeded accounts. Dev defaults are admin1234 / demo1234; in production the
# accounts are ONLY created when these are set explicitly.
# ADMIN_PASSWORD=
# DEMO_PASSWORD=

# FatSecret Platform (https://platform.fatsecret.com — free Basic tier).
# When set, FatSecret is the primary food-search source (USDA becomes backup).
# Remember to allow your server egress IPs in the FatSecret console.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# The browser-facing origin. OAuth redirect URIs derive from it — set to the
# real site URL in production (e.g. https://yourdomain.com).
# PUBLIC_URL=http://localhost:5174

# Google sign-in (console.cloud.google.com → APIs & Services → Credentials →
# OAuth client ID, type "Web application"). Register the redirect URI
# {PUBLIC_URL}/v1/auth/google/callback for every environment.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Set to 1 ONLY once traffic flows through Cloudflare — client IPs then come
# from CF-Connecting-IP (rate limits and IP bans keep working).
# TRUST_CF_PROXY=1

# Stripe (dashboard.stripe.com → Developers → API keys). Use test-mode keys
# locally. The webhook secret comes from `stripe listen` in dev, or from the
# dashboard webhook endpoint ({PUBLIC_URL}/v1/stripe/webhook) in production.
# The price id is the $5/month recurring price on the "Atlas Pro" product.
# All three must be set for checkout to open — otherwise the app keeps its
# "payments coming soon" state.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# Second price on the SAME product ($72/year). Optional — unset hides annual.
# STRIPE_PRICE_ID_ANNUAL=

# Resend (resend.com → API Keys, "Sending access" scoped to the domain).
# Unset = password reset and email verification report themselves unavailable.
# EMAIL_FROM overrides the sender (default: Atlas <no-reply@atlas-fitness.org>).
# RESEND_API_KEY=
# EMAIL_FROM=
