# Base URL of the Arcadia API (Railway in prod, local docker/dev otherwise).
# Not required yet — the app is local-first; sync features will use this later.
VITE_API_URL=http://localhost:3000

# wger instance serving exercise data. Defaults to https://wger.de when unset.
# For the self-hosted stack (npm run wger:up):
VITE_WGER_URL=http://localhost:8001
