# Base URL of the Arcadia API (Railway in prod, local docker/dev otherwise).
# Not required yet — the app is local-first; sync features will use this later.
VITE_API_URL=http://localhost:3000

# Dev server only: the login page shows a one-tap sign-in for this account.
# Defaults to the API's seeded demo account (demo@arcadia.dev / demo1234).
# VITE_DEV_LOGIN_EMAIL=demo@arcadia.dev
# VITE_DEV_LOGIN_PASSWORD=demo1234
